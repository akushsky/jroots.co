DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ADMIN_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
SENTRY_DSN=
ENVIRONMENT=development
MEDIA_PATH=./media

# --- JRoots Chat (M1/M2) ---
# Moonshot AI (Kimi) — LLM для чата
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL_MAIN=kimi-k2.6
LLM_MODEL_ESCALATION=kimi-k3
LLM_TOKEN_CAP_PER_SESSION=200000
LLM_PRICE_IN_PER_1M=0.95
LLM_PRICE_OUT_PER_1M=4.0
FREE_DAILY_BUDGET_USD=20.0
FREE_SESSIONS_PER_DAY=2

# jroots-mcp-server (streamable-HTTP)
JROOTS_MCP_ENABLED=true
JROOTS_MCP_URL=http://localhost:8100
JROOTS_MCP_TOKEN=
JROOTS_MCP_TIMEOUT_SECONDS=30.0

# --- Payments (M4) ---
PUBLIC_BASE_URL=http://localhost:8000
# Polar (Merchant of Record), sandbox: https://sandbox.polar.sh
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_SANDBOX=true
POLAR_PRODUCT_ID_DELO=
POLAR_PRODUCT_ID_RESEARCHER=
POLAR_PRODUCT_ID_SCANS_PACK=
POLAR_PRODUCT_ID_PPR=
# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# YuKassa (RU)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_CURRENCY=RUB
YUKASSA_USD_RATE=90.0
