DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname
SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ADMIN_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
SENTRY_DSN=
ENVIRONMENT=development
MEDIA_PATH=./media

# Invite-only: false rejects POST /api/register (pair with VITE_REGISTRATION_ENABLED=false).
REGISTRATION_ENABLED=true
# Optional: create/promote verified admin on container start (entrypoint).
# BOOTSTRAP_ADMIN_EMAIL=michael.akushsky@gmail.com
# BOOTSTRAP_ADMIN_USERNAME=michael

# --- JRoots Chat (M1/M2) ---
# LLM provider: gemini (default) | moonshot. One switch; model/price fall
# back to the provider profile unless overridden below.
LLM_PROVIDER=gemini

# Gemini (OpenAI-compatible endpoint)
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: low | high — cuts Gemini thinking tokens when set.
# LLM_REASONING_EFFORT=low

# Moonshot AI / Kimi (fallback: LLM_PROVIDER=moonshot)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional overrides (defaults come from the active provider profile):
# Gemini → gemini-3.1-pro-preview / $2 / $12 per 1M
# Moonshot → kimi-k2.6 / kimi-k3 / $0.95 / $4 per 1M
# LLM_MODEL_MAIN=
# LLM_MODEL_ESCALATION=
# LLM_PRICE_IN_PER_1M=
# LLM_PRICE_OUT_PER_1M=
LLM_TOKEN_CAP_PER_SESSION=200000
FREE_DAILY_BUDGET_USD=20.0
FREE_SESSIONS_PER_DAY=2

# jroots-mcp-server (streamable-HTTP)
JROOTS_MCP_ENABLED=true
JROOTS_MCP_URL=http://localhost:8100
JROOTS_MCP_TOKEN=
JROOTS_MCP_TIMEOUT_SECONDS=30.0
# Token diet: max chars of a tool result shown to the model.
MCP_TOOL_RESULT_MAX_CHARS=8000
# After N tool rounds, collapse older tool results to one-line digests,
# keeping the last K rounds intact.
AGENT_COLLAPSE_AFTER_ROUNDS=4
AGENT_COLLAPSE_KEEP_ROUNDS=2

# --- Payments (M4) ---
PUBLIC_BASE_URL=http://localhost:8000
# Polar (Merchant of Record), sandbox: https://sandbox.polar.sh
POLAR_API_KEY=
POLAR_WEBHOOK_SECRET=
POLAR_SANDBOX=true
POLAR_PRODUCT_ID_DELO=
POLAR_PRODUCT_ID_RESEARCHER=
POLAR_PRODUCT_ID_SCANS_PACK=
POLAR_PRODUCT_ID_PPR=
# NOWPayments (crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# YuKassa (RU)
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_CURRENCY=RUB
YUKASSA_USD_RATE=90.0
